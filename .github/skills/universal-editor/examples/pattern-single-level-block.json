{
  "description": "Action-card style pattern where items are fixed-field and do not host nested child components.",
  "basedOn": "examples/reference/action-card.json",
  "definitions": [
    {
      "id": "example-block",
      "resourceType": "core/franklin/components/block/v1/block",
      "template": {
        "model": "example-block",
        "filter": "example-block"
      }
    },
    {
      "id": "example-block-item",
      "resourceType": "core/franklin/components/block/v1/block/item",
      "template": {
        "model": "example-block-item",
        "filter": "example-block-item"
      }
    }
  ],
  "models": [
    {
      "id": "example-block",
      "fields": [
        {
          "component": "text",
          "name": "heading",
          "label": "Heading",
          "required": true
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Mode",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        }
      ]
    },
    {
      "id": "example-block-item",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Image",
          "required": true
        },
        {
          "component": "text",
          "name": "card-heading",
          "label": "Card heading",
          "required": true
        },
        {
          "component": "richtext",
          "name": "description",
          "label": "Description"
        },
        {
          "component": "text",
          "name": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "example-block",
      "components": ["example-block-item"],
      "min": 1,
      "max": 12
    },
    {
      "id": "example-block-item",
      "components": []
    }
  ]
}
