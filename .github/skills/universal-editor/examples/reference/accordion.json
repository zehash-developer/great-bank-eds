  ],
  "models": [
    {
      "id": "accordion",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "value": "",
          "label": "Accordion Title",
          "valueType": "string",
          "description": "Optional heading displayed above the accordion group"
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Mode",
          "description": "Choose light or dark color scheme",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        }
      ]
    },
    {
      "id": "accordion-item",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "value": "",
          "label": "Panel Title",
          "valueType": "string",
          "description": "The title shown in the accordion header (required, max 256 characters)",
          "required": true,
          "validation": {
            "maxLength": 256,
            "pattern": "^[^\\s].*$",
            "customErrorMsg": "Panel title is required, must not start with a space, and cannot exceed 256 characters"
          }
        },
        {
          "component": "richtext",
          "name": "content",
          "value": "",
          "label": "Panel Content",
          "valueType": "string",
          "description": "The content revealed when the panel is expanded"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "accordion",
      "components": [
        "accordion-item"
      ],
      "min": 1,
      "max": 15,
      "minErrorMsg": "An accordion group must have at least 1 accordion inside it",
      "maxErrorMsg": "An accordion group cannot have more than 15 accordions inside it"
    },
    {
      "id": "accordion-item",
      "components": [
        "text",
        "image",
        "button",
        "title",
        "card"
      ]
    }
  ]
