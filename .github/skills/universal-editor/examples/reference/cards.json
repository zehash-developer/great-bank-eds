{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Cards",
              "model": "cards",
              "filter": "cards"
            }
          }
        }
      }
    },
    {
      "title": "Card Item",
      "id": "card-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card Item",
              "model": "card-item",
              "filter": "card-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "select",
          "name": "type",
          "label": "Type",
          "description": "Select background type",
          "required": true,
          "default": "gray",
          "options": [
            {
              "name": "Gray background",
              "value": "gray"
            },
            {
              "name": "White background",
              "value": "white"
            },
            {
              "name": "White background Gray Filled Cards",
              "value": "white-gray"
            }
          ]
        },
        {
          "component": "text",
          "name": "heading",
          "value": "",
          "label": "Heading",
          "valueType": "string",
          "required": true,
          "description": "Provide a heading. Limit content to 1-60 characters.",
          "validation": {
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^\\s].*$",
            "customErrorMsg": "Heading is required and must be between 1 and 60 characters"
          }
        },
        {
          "component": "text",
          "name": "info-text",
          "value": "",
          "label": "Info Text",
          "valueType": "string",
          "required": false,
          "description": "Optional informational text that appears below the heading"
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Mode",
          "value": "",
          "description": "Choose light or dark color scheme",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        }
      ]
    },
    {
      "id": "card-item",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "value": "",
          "label": "Title",
          "valueType": "string",
          "required": true,
          "description": "Card title (1-46 characters)",
          "validation": {
            "minLength": 1,
            "maxLength": 46,
            "pattern": "^.{1,46}$",
            "customErrorMsg": "Title is required and must be between 1 and 46 characters"
          }
        },
        {
          "component": "richtext",
          "name": "description",
          "value": "",
          "label": "Description",
          "valueType": "string",
          "required": false,
          "description": "Optional card description (maximum 176 characters) - allows hyperlinks and superscripts",
          "validation": {
            "maxLength": 176,
            "pattern": "^.{0,176}$",
            "customErrorMsg": "Description must not exceed 176 characters"
          }
        },
        {
          "component": "select",
          "name": "card-image-type",
          "label": "Card Image Type",
          "value": "image",
          "description": "Choose between image or pictogram",
          "required": true,
          "options": [
            {
              "name": "Image",
              "value": "image"
            },
            {
              "name": "Pictogram",
              "value": "pictogram"
            }
          ]
        },
        {
          "component": "reference",
          "name": "image",
          "value": "",
          "label": "Image",
          "valueType": "string",
          "required": false,
          "description": "Card image - displays full width at the top of the card",
          "condition": {
            "===": [
              {
                "var": "card-image-type"
              },
              "image"
            ]
          }
        },
        {
          "component": "text",
          "name": "pictogram",
          "value": "",
          "label": "Pictogram (Icon)",
          "valueType": "string",
          "required": false,
          "description": "Card pictogram - displays at the top of the card",
          "condition": {
            "===": [
              {
                "var": "card-image-type"
              },
              "pictogram"
            ]
          }
        },
        {
          "component": "boolean",
          "name": "show-cta",
          "label": "Show CTA",
          "valueType": "boolean"
        },
        {
          "component": "text",
          "name": "cta1-label",
          "value": "",
          "label": "CTA 1 Label",
          "valueType": "string",
          "required": false,
          "description": "Label for the first call-to-action button",
          "condition": {
            "==": [
              {
                "var": "show-cta"
              },
              true
            ]
          }
        },
        {
          "component": "aem-content",
          "name": "cta1-url",
          "value": "",
          "label": "CTA 1 URL",
          "valueType": "string",
          "required": false,
          "description": "URL for the first call-to-action button",
          "condition": {
            "==": [
              {
                "var": "show-cta"
              },
              true
            ]
          }
        },
        {
          "component": "select",
          "name": "cta1-variant",
          "label": "CTA 1 Variant",
          "value": "primary",
          "description": "Select button style for CTA 1",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Tertiary",
              "value": "tertiary"
            }
          ],
          "condition": {
            "==": [
              {
                "var": "show-cta"
              },
              true
            ]
          }
        },
        {
          "component": "text",
          "name": "cta2-label",
          "value": "",
          "label": "CTA 2 Label",
          "valueType": "string",
          "required": false,
          "description": "Label for the second call-to-action button",
          "condition": {
            "==": [
              {
                "var": "show-cta"
              },
              true
            ]
          }
        },
        {
          "component": "aem-content",
          "name": "cta2-url",
          "value": "",
          "label": "CTA 2 URL",
          "valueType": "string",
          "required": false,
          "description": "URL for the second call-to-action button",
          "condition": {
            "==": [
              {
                "var": "show-cta"
              },
              true
            ]
          }
        },
        {
          "component": "select",
          "name": "cta2-variant",
          "label": "CTA 2 Variant",
          "value": "secondary",
          "description": "Select button style for CTA 2",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Tertiary",
              "value": "tertiary"
            }
          ],
          "condition": {
            "==": [
              {
                "var": "show-cta"
              },
              true
            ]
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": [
        "card-item"
      ]
    },
    {
      "id": "card-item",
      "components": []
    }
  ]
}