{
  "definitions": [
    {
      "title": "Feature List",
      "id": "feature-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Feature List",
              "model": "feature-list",
              "filter": "feature-list"
            }
          }
        }
      }
    },
    {
      "title": "Feature Item",
      "id": "feature-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Feature Item",
              "model": "feature-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "feature-list",
      "fields": [
       {
          "component": "select",
          "name": "type",
          "label": "Feature List Type",
          "description": "Select the variant. White allows hyperlinks (1-8 items). Grey has no hyperlinks (1-5 items).",
          "valueType": "string",
          "required": true,
          "options": [
            {
              "name": "White",
              "value": "white"
            },
            {
              "name": "Grey",
              "value": "grey"
            }
          ]
        },
        {
          "component": "text",
          "name": "heading",
          "value": "",
          "label": "Heading",
          "valueType": "string",
          "description": "Optional heading displayed above the feature list (approx. 35 characters). Renders as visual H5, semantic H2 for accessibility.",
          "validation": {
            "minLength": 1,
            "maxLength": 35
          },
          "condition":{
            "===": [
            {
              "var": "type"
            },
            "grey"
          ]
          }
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Mode",
          "description": "Choose light or dark color scheme",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        }
      ]
    },
    {
      "id": "feature-item",
      "fields": [
        {
          "component": "select",
          "name": "icon",
          "label": "Icon",
          "valueType": "string",
          "description": "Select a GEL filled icon for this feature. Use filled icons (no suffix) or outlined icons (-outlined suffix).",
          "required": true,
          "options": [
            { "...": "./_filled-icons.json" }
          ]
        },
        {
          "component": "richtext",
          "name": "description",
          "value": "",
          "label": "Feature Description",
          "valueType": "string",
          "description": "Describe the feature (required, max 180 characters)",
          "required": true,
          "validation": {
            "maxLength": 180
          }
        },
        {
          "component": "aem-content",
          "name": "url",
          "label": "Hyperlink",
          "description": "Link URL for this feature (White variant only)"
        },
        {
          "component": "text",
          "name": "linkLabel",
          "value": "Discover more",
          "label": "Link Text",
          "valueType": "string",
          "description": "Text to display for the hyperlink"
        },
        {
          "component": "boolean",
          "name": "linkNewWindow",
          "value": false,
          "label": "Open in New Window",
          "description": "Open the link in a new browser window/tab (White variant only)"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "feature-list",
      "components": [
        "feature-item"
      ],
      "min": 1,
      "max": 8,
      "minErrorMsg": "A feature list must have at least 1 feature item",
      "maxErrorMsg": "A feature list cannot have more than 8 items (White variant) or 5 items (Grey variant)"
    },
    {
      "id": "columns-content",
      "components": [
        "feature-list"
      ]
    },
    {
      "id": "accordion-item",
      "components": [
        "feature-list"
      ]
    }
  ]
}
