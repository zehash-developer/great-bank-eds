{
  "definitions": [
    {
      "title": "Page Header",
      "id": "page-header",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Page Header",
              "model": "page-header"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "page-header",
      "fields": [
        {
          "component": "tab",
          "name": "generalTab",
          "label": "General"
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Variation",
          "description": "Select the page header variation",
          "required": true,
          "options": [
            {
              "name": "Full Bleed",
              "value": "full-bleed"
            },
            {
              "name": "White",
              "value": ""
            }
          ]
        },
        {
          "component": "select",
          "name": "mode",
          "label": "Mode",
          "description": "Choose light or dark color scheme",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        },
        {
          "component": "select",
          "name": "offerType",
          "label": "Offer Type",
          "description": "Select offer type (Full-Bleed only)",
          "options": [
            {
              "name": "None",
              "value": "none"
            },
            {
              "name": "Single",
              "value": "single"
            },
            {
              "name": "Dual",
              "value": "dual"
            }
          ],
          "condition": {
            "===": [{ "var": "classes" }, "full-bleed"]
          }
        },
        {
          "component": "boolean",
          "name": "hideBreadcrumb",
          "label": "Hide Breadcrumb",
          "description": "Select to hide the breadcrumb navigation",
          "valueType": "boolean"
        },
        {
          "component": "text",
          "name": "subtitle",
          "label": "Subtitle",
          "description": "Add optional subtitle (max 65 characters)",
          "valueType": "string",
          "validation": {
            "maxLength": 65
          }
        },
        {
          "component": "text",
          "name": "heading",
          "label": "Heading",
          "description": "Add heading to override page property page title (max 50 characters)",
          "valueType": "string",
          "validation": {
            "maxLength": 50
          }
        },
        {
          "component": "richtext",
          "name": "leadText",
          "label": "Lead Text",
          "description": "Add optional lead text (max 150 characters recommended)",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "byline",
          "label": "Offer By-line",
          "description": "Add optional by-line (max 210 characters recommended)",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "finePrint",
          "label": "Fine Print",
          "description": "Add optional fine print (max 273 characters recommended)",
          "valueType": "string"
        },
        {
          "component": "tab",
          "name": "imageTab",
          "label": "Image"
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Image",
          "description": "Add image (required for Full Bleed, optional for White)",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Alt Text",
          "description": "Alternative text for the image (for accessibility)",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "textType",
          "label": "Text Type",
          "description": "Choose text color based on image background",
          "options": [
            {
              "name": "Light Text (for dark images)",
              "value": "light"
            },
            {
              "name": "Dark Text (for light images)",
              "value": "dark"
            }
          ],
          "condition": {
            "===": [{ "var": "classes" }, "full-bleed"]
          }
        },
        {
          "component": "tab",
          "name": "singleOfferTab",
          "label": "Single Offer",
          "condition": {
            "===": [{ "var": "offerType" }, "single"]
          }
        },
        {
          "component": "richtext",
          "name": "singleOfferTopLabel",
          "label": "Big Number Top Label",
          "description": "Provide the top label for the offer value/number (max 56 characters)",
          "valueType": "string",
          "condition": {
            "===": [{ "var": "offerType" }, "single"]
          }
        },
        {
          "component": "text",
          "name": "singleOfferBigNumber",
          "label": "Big Number",
          "description": "Provide the offer value/number (max 15 characters)",
          "valueType": "string",
          "validation": {
            "maxLength": 15
          },
          "condition": {
            "===": [{ "var": "offerType" }, "single"]
          }
        },
        {
          "component": "richtext",
          "name": "singleOfferSupportingText",
          "label": "Supporting Text",
          "description": "Provide the supporting text (max 50 characters)",
          "valueType": "string",
          "condition": {
            "===": [{ "var": "offerType" }, "single"]
          }
        },
        {
          "component": "boolean",
          "name": "singleOfferIncludePA",
          "label": "Include % p.a.",
          "description": "Select to add '% p.a.' to the offer value",
          "valueType": "boolean",
          "condition": {
            "===": [{ "var": "offerType" }, "single"]
          }
        },
        {
          "component": "tab",
          "name": "dualOfferTab",
          "label": "Dual Offer",
          "condition": {
            "===": [{ "var": "offerType" }, "dual"]
          }
        },
        {
          "component": "container",
          "name": "offer1Container",
          "label": "Offer 1",
          "collapsible": true,
          "condition": {
            "===": [{ "var": "offerType" }, "dual"]
          },
          "fields": [
            {
              "component": "richtext",
              "name": "offer1TopLabel",
              "label": "Top Label",
              "description": "Provide the top label for the first offer (max 56 characters)",
              "valueType": "string"
            },
            {
              "component": "text",
              "name": "offer1BigNumber",
              "label": "Big Number",
              "description": "Provide the first offer value/number (max 15 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 15
              }
            },
            {
              "component": "richtext",
              "name": "offer1BottomLabel",
              "label": "Bottom Label",
              "description": "Provide the bottom label for the first offer (max 56 characters)",
              "valueType": "string"
            }
          ]
        },
        {
          "component": "container",
          "name": "offer2Container",
          "label": "Offer 2",
          "collapsible": true,
          "condition": {
            "===": [{ "var": "offerType" }, "dual"]
          },
          "fields": [
            {
              "component": "richtext",
              "name": "offer2TopLabel",
              "label": "Top Label",
              "description": "Provide the top label for the second offer (max 56 characters)",
              "valueType": "string"
            },
            {
              "component": "text",
              "name": "offer2BigNumber",
              "label": "Big Number",
              "description": "Provide the second offer value/number (max 15 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 15
              }
            },
            {
              "component": "richtext",
              "name": "offer2BottomLabel",
              "label": "Bottom Label",
              "description": "Provide the bottom label for the second offer (max 56 characters)",
              "valueType": "string"
            }
          ]
        },
        {
          "component": "boolean",
          "name": "dualOfferIncludePA",
          "label": "Include % p.a.",
          "description": "Select to add '% p.a.' to the offer values",
          "valueType": "boolean",
          "condition": {
            "===": [{ "var": "offerType" }, "dual"]
          }
        },
        {
          "component": "tab",
          "name": "buttonsTab",
          "label": "Buttons"
        },
        {
          "component": "boolean",
          "name": "enableButtons",
          "label": "Enable Buttons",
          "description": "Slide toggle to enable page header buttons",
          "valueType": "boolean"
        },
        {
          "component": "container",
          "name": "primaryButtonContainer",
          "label": "Primary Button",
          "collapsible": true,
          "condition": {
            "===": [{ "var": "enableButtons" }, true]
          },
          "fields": [
            {
              "component": "text",
              "name": "primaryLabel",
              "label": "Primary Label",
              "description": "Provide a label for desktop URLs (max 35 characters)",
              "valueType": "string",
              "required": true,
              "validation": {
                "maxLength": 35
              }
            },
            {
              "component": "aem-content",
              "name": "primaryUrl",
              "label": "URL",
              "description": "Provide navigation URL of the button",
              "required": true
            },
            {
              "component": "text",
              "name": "primaryMobileLabel",
              "label": "Label (mobile)",
              "description": "Provide a label for mobile URLs (max 35 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 35
              }
            },
            {
              "component": "aem-content",
              "name": "primaryMobileUrl",
              "label": "URL (mobile)",
              "description": "Provide navigation URL for mobile"
            },
            {
              "component": "boolean",
              "name": "primaryNewWindow",
              "label": "Open in new window",
              "valueType": "boolean"
            },
            {
              "component": "select",
              "name": "primaryAvailability",
              "label": "Availability",
              "description": "Choose the availability of URL",
              "options": [
                {
                  "name": "Both",
                  "value": "both"
                },
                {
                  "name": "Desktop only",
                  "value": "desktop"
                },
                {
                  "name": "Mobile only",
                  "value": "mobile"
                }
              ]
            }
          ]
        },
        {
          "component": "container",
          "name": "secondaryButtonContainer",
          "label": "Secondary Button",
          "collapsible": true,
          "condition": {
            "===": [{ "var": "enableButtons" }, true]
          },
          "fields": [
            {
              "component": "text",
              "name": "secondaryLabel",
              "label": "Secondary Label",
              "description": "Provide a label for desktop URLs (max 35 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 35
              }
            },
            {
              "component": "aem-content",
              "name": "secondaryUrl",
              "label": "URL",
              "description": "Provide navigation URL of the button"
            },
            {
              "component": "text",
              "name": "secondaryMobileLabel",
              "label": "Label (mobile)",
              "description": "Provide a label for mobile URLs (max 35 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 35
              }
            },
            {
              "component": "aem-content",
              "name": "secondaryMobileUrl",
              "label": "URL (mobile)",
              "description": "Provide navigation URL for mobile"
            },
            {
              "component": "boolean",
              "name": "secondaryNewWindow",
              "label": "Open in new window",
              "valueType": "boolean"
            },
            {
              "component": "select",
              "name": "secondaryAvailability",
              "label": "Availability",
              "description": "Choose the availability of URL",
              "options": [
                {
                  "name": "Both",
                  "value": "both"
                },
                {
                  "name": "Desktop only",
                  "value": "desktop"
                },
                {
                  "name": "Mobile only",
                  "value": "mobile"
                }
              ]
            }
          ]
        },
        {
          "component": "container",
          "name": "tertiaryButtonContainer",
          "label": "Tertiary Button",
          "collapsible": true,
          "condition": {
            "===": [{ "var": "enableButtons" }, true]
          },
          "fields": [
            {
              "component": "text",
              "name": "tertiaryLabel",
              "label": "Tertiary Label",
              "description": "Provide a label for desktop URLs (max 35 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 35
              }
            },
            {
              "component": "aem-content",
              "name": "tertiaryUrl",
              "label": "URL",
              "description": "Provide navigation URL of the button"
            },
            {
              "component": "text",
              "name": "tertiaryMobileLabel",
              "label": "Label (mobile)",
              "description": "Provide a label for mobile URLs (max 35 characters)",
              "valueType": "string",
              "validation": {
                "maxLength": 35
              }
            },
            {
              "component": "aem-content",
              "name": "tertiaryMobileUrl",
              "label": "URL (mobile)",
              "description": "Provide navigation URL for mobile"
            },
            {
              "component": "boolean",
              "name": "tertiaryNewWindow",
              "label": "Open in new window",
              "valueType": "boolean"
            }
          ]
        }
      ]
    }
  ],
  "filters": []
}
