{
  "definitions": [
    {
      "title": "Tab",
      "id": "tab",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tab",
              "model": "tab",
              "filter": "tab"
            }
          }
        }
      }
    },
    {
      "title": "Tab Item",
      "id": "tab-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Tab Item",
              "model": "tab-item",
              "filter": "tab-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tab",
      "fields": [
        {
          "component": "text",
          "name": "heading",
          "value": "",
          "label": "Heading",
          "valueType": "string",
          "required": false,
          "description": "Optional heading displayed above the tabs. Leave empty if no heading is needed.",
          "validation": {
            "maxLength": 78
          }
        },
        {
          "component": "select",
          "name": "type",
          "value": "white-without-icons",
          "label": "Type",
          "valueType": "string",
          "required": true,
          "description": "Choose the tab type. Note: With icons variants support max 4 tabs, without icons variants support max 6 tabs.",
          "options": [
            {
              "name": "White with icons",
              "value": "white-with-icons"
            },
            {
              "name": "Grey with icons",
              "value": "grey-with-icons"
            },
            {
              "name": "White without icons",
              "value": "white-without-icons"
            },
            {
              "name": "Grey without icons",
              "value": "grey-without-icons"
            }
          ]
        }, 
        {
          "component": "select",
          "name": "classes",
          "value": "",
          "label": "Mode",
          "valueType": "string",
          "description": "Choose light, dark, or grey mode for the tab block",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        }
      ]
    },
    {
      "id": "tab-item",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "value": "",
          "label": "Tab Label",
          "valueType": "string",
          "required": true,
          "description": "Tab button label text",
          "validation": {
            "maxLength": 30
          }
        },
        {
          "component": "multiselect",
          "name": "icon",
          "value": "",
          "label": "Icon",
          "valueType": "string",
          "description": "Select a GEL filled icon for this tab (optional). Icon will appear to the left of the label.",
          "options": [
            {
              "name": "None",
              "value": ""
            },
            { "...": "./_filled-icons.json" }
          ]
        },
        {
          "component": "richtext",
          "name": "content",
          "value": "",
          "label": "Tab Content",
          "valueType": "string",
          "required": false,
          "description": "Tab panel content. Can include rich text, images, and nested blocks."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tab",
      "components": [
        "tab-item"
      ],
      "min": 2,
      "max": 6,
      "minErrorMsg": "A tab block must have at least 2 tabs",
      "maxErrorMsg": "A tab block cannot have more than 6 tabs (4 for with-icons variants)"
    },
    {
      "id": "tab-item",
      "components": []
    }
  ]
}
