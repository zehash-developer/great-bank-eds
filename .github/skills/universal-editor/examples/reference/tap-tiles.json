          "required": true,
          "options": [
            {
              "name": "Grey background",
              "value": "grey"
            },
            {
              "name": "White background",
              "value": ""
            }
          ]
        },
        {
          "component": "text",
          "name": "heading",
          "value": "",
          "label": "Heading",
          "valueType": "string",
          "required": true,
          "description": "Provide a heading. Limit content to 1-60 characters.",
          "validation": {
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^\\s].*$",
            "customErrorMsg": "Heading is required and must be between 1 and 60 characters"
          }
        },
         {
          "component": "select",
          "name": "classes",
          "label": "Mode",
          "value": "",
          "description": "Choose light or dark color scheme",
          "options": [
            {
              "name": "Light",
              "value": ""
            },
            {
              "name": "Dark",
              "value": "dark"
            }
          ]
        }
      ]
    },
    {
      "id": "tap-tile",
      "fields": [
        {
          "component": "multiselect",
          "name": "icon",
          "value": "",
          "label": "Icon",
          "valueType": "string",
          "description": "Select a GEL filled icon for this tile (optional)",
          "options": [
            {
              "name": "None",
              "value": ""
            },
            { "...": "./_filled-icons.json" }
          ]
        },
        {
          "component": "text",
          "name": "heading",
          "value": "",
          "label": "Heading",
          "valueType": "string",
          "required": true,
          "description": "Provide a heading for the tile"
        },
        {
          "component": "aem-content",
          "name": "url",
          "label": "Link",
          "description": "Provide the URL for the tile link"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tap-tiles",
      "components": [
        "tap-tile"
