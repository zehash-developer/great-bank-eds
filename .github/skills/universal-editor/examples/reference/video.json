{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "model": "video",
              "filter": "video"
            }
          }
        }
      }
    },
    {
      "title": "Video Item",
      "id": "video-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Video Item",
              "model": "video-item",
              "filter": "video-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "richtext",
          "name": "caption",
          "label": "Caption (Single Video Only)",
          "valueType": "string",
          "required": false,
          "description": "Provide a video caption."
        }
      ]
    },
    {
      "id": "video-item",
      "fields": [
        {
          "component": "text",
          "name": "video-id",
          "label": "YouTube video ID",
          "valueType": "string",
          "required": true,
          "description": "Provide YouTube ID of video including any parameters, e.g. dQw4w9WgXcQ?rel=0",
          "validation": {
            "minLength": 1,
            "pattern": "^.+$",
            "customErrorMsg": "Video ID or URL is required"
          }
        },
        {
          "component": "text",
          "name": "title",
          "value": "",
          "label": "Video Thumbnail Title (Multiple Videos Only)",
          "valueType": "string",
          "required": false,
          "description": "Provide Video Thumbnail Title.",
          "validation": {
            "maxLength": 100,
            "pattern": "^.{0,100}$",
            "customErrorMsg": "Title must not exceed 100 characters"
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "video",
      "components": [
        "video-item"
      ],
      "min": 1,
      "minErrorMsg": "A video block must have at least 1 video item"
    }
  ]
}