{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint . --ext .json,.js,.mjs",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "mcp:sync": "node scripts/sync-cursor-mcp.mjs",
    "stylelint:fix": "stylelint \"blocks/**/*.css\" \"styles/**/*.css\" --fix",
    "build:json": "npm-run-all2 -p build:json:models build:json:definitions build:json:filters",
    "build:json:models": "merge-json-cli -i \"models/_component-models.json\" -o \"component-models.json\"",
    "build:json:definitions": "merge-json-cli -i \"models/_component-definition.json\" -o \"component-definition.json\"",
    "build:json:filters": "merge-json-cli -i \"models/_component-filters.json\" -o \"component-filters.json\"",
    "prepare": "husky",
    "test:unit": "npm run build:json --silent && mocha",
    "test:e2e": "playwright test",
    "test:storybook": "test-storybook",
    "debug:e2e": "playwright test --project='chromium' --debug",
    "gel:extract-icons": "node scripts/extract-gel-icons.js",
    "gel:manifests": "node scripts/extract-gel-icons.js --manifests-only",
    "gel:extract": "npm run gel:extract-icons",
    "scss:compile": "node scripts/build-scss.js",
    "scss:build": "npm run scss:compile && npm run stylelint:fix",
    "scss:watch": "chokidar \"blocks/**/*.scss\" \"styles/_variables.scss\" \"styles/styles.scss\" -c \"npm run scss:compile\"",
    "storybook:serve": "storybook dev -p 6006",
    "storybook": "npm run scss:compile && npm-run-all2 --parallel scss:watch storybook:serve",
    "storybook:build": "npm run scss:build && storybook build",
    "figma:compare": "node tools/figma-storybook-compare.js",
    "update:formula": "rollup -c rollup/jsonformula.rollup.config.js",
    "update:core": "rollup -c rollup/af-core.rollup.config.js",
    "update:formatters": "rollup -c rollup/af-formatters.rollup.config.js",
    "update:functions": "cp node_modules/@aemforms/af-custom-functions/src/index.js blocks/form/rules/functions.js",
    "update": "npm run update:core && npm run update:formula && npm run update:formatters",
    "update:mappings": "node tools/update-mappings.js",
    "create:custom-component": "node tools/forms-scaffolder.js",
    "postinstall": "npm run gel:extract-icons && npx playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@adobe/json-formula": "0.1.50",
    "@aemforms/af-core": "0.22.157",
    "@aemforms/af-custom-functions": "1.0.14",
    "@aemforms/af-formatters": "0.22.157",
    "@babel/eslint-parser": "7.28.0",
    "@playwright/test": "^1.43.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/html": "^8.6.18",
    "@storybook/html-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.21.0",
    "@testing-library/dom": "9.3.4",
    "@testing-library/user-event": "14.3.0",
    "@types/node": "20.12.7",
    "c8": "9.0.0",
    "chai": "5.1.0",
    "chokidar-cli": "^3.0.0",
    "cssnano": "^7.1.3",
    "dom-compare": "0.6.0",
    "enquirer": "2.4.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-xwalk": "github:adobe-rnd/eslint-plugin-xwalk#v0.1.3",
    "fs-extra": "11.2.0",
    "husky": "9.1.1",
    "jsdom": "24.0.0",
    "jsdom-global": "3.0.2",
    "merge-json-cli": "1.0.4",
    "mocha": "10.2.0",
    "mutationobserver-shim": "0.3.7",
    "nock": "13.5.4",
    "node-fetch": "^3.3.2",
    "npm-run-all2": "^8.0.4",
    "nyc": "^15.1.0",
    "parse-multipart-data": "^1.5.0",
    "picomatch": "^4.0.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "postcss-import": "^16.1.1",
    "postcss-scss": "^4.0.9",
    "rollup": "^2.79.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.0.1",
    "rollup-plugin-terser": "^7.0.2",
    "sass": "^1.94.2",
    "sinon": "^17.0.1",
    "storybook": "^8.4.7",
    "stylelint": "16.21.1",
    "stylelint-config-standard": "38.0.0",
    "stylelint-html-reporter": "^0.0.8",
    "unzipper": "^0.12.2",
    "vite": "^5.4.0"
  }
}
